    "eventFlows": [
      {
        "name": "Order Placement Saga",
        "steps": [
          "Client → API Gateway → Order Service",
          "Order Service → Inventory Service (reserve stock)",
          "Order Service → Payment Service (charge)",
          "Payment Service publishes payment.completed",
          "Order Service updates status → notification-service sends confirmation",
          "On failure: compensating transactions rollback inventory & payment"
        ]
      },
      {
        "name": "Catalog Update Flow",
        "steps": [
          "Admin updates product in Catalog Service",
          "Catalog Service publishes product.updated to Kafka",
          "Search Service indexes update",
          "Cart Service invalidates cached prices",
          "Inventory Service syncs product metadata"
        ]
      }
    ],
    "apiContracts": [
      {
        "service": "user-service",
        "endpoint": "/api/v1/users/register",
        "method": "POST",
        "description": "Register new user",
        "request": "{ \"email\": \"string\", \"password\": \"string\", \"name\": \"string\" }",
        "response": "{ \"id\": \"uuid\", \"email\": \"string\", \"token\": \"jwt\" }"
      },
      {
        "service": "catalog-service",
        "endpoint": "/api/v1/products",
        "method": "GET",
        "description": "List products with pagination",
        "request": "?page=0&size=20&category=uuid",
        "response": "{ \"content\": [...], \"totalElements\": 100 }"
      },
      {
        "service": "cart-service",
        "endpoint": "/api/v1/carts/{userId}/items",
        "method": "POST",
        "description": "Add item to cart",
        "request": "{ \"productId\": \"uuid\", \"quantity\": 2 }",
        "response": "{ \"cartId\": \"uuid\", \"items\": [...], \"total\": 99.99 }"
      },
      {
        "service": "order-service",
        "endpoint": "/api/v1/orders",
        "method": "POST",
        "description": "Create order from cart",
        "request": "{ \"cartId\": \"uuid\", \"shippingAddress\": {...} }",
        "response": "{ \"orderId\": \"uuid\", \"status\": \"PENDING\", \"total\": 199.99 }"
      }
    ],
    "kafkaTopics": [
      {
        "name": "order.created",
        "description": "New order placed",
        "producers": [
          "order-service"
        ],
        "consumers": [
          "inventory-service",
          "notification-service"
        ],
        "schema": "{ \"orderId\": \"uuid\", \"userId\": \"uuid\", \"items\": [], \"total\": \"decimal\" }"
      },
      {
        "name": "payment.completed",
        "description": "Payment successfully processed",
        "producers": [
          "payment-service"
        ],
        "consumers": [
          "order-service",
          "notification-service"
        ],
        "schema": "{ \"paymentId\": \"uuid\", \"orderId\": \"uuid\", \"amount\": \"decimal\" }"
      },
      {
        "name": "inventory.reserved",
        "description": "Stock reserved for order",
        "producers": [
          "inventory-service"
        ],
        "consumers": [
          "order-service"
        ],
        "schema": "{ \"orderId\": \"uuid\", \"productId\": \"uuid\", \"quantity\": \"int\" }"
      },
      {
        "name": "product.updated",
        "description": "Product catalog change",
        "producers": [
          "catalog-service"
        ],
        "consumers": [
          "cart-service",
          "search-service"
        ],
        "schema": "{ \"productId\": \"uuid\", \"price\": \"decimal\", \"name\": \"string\" }"
      }
    ],
    "redisUsage": [
      {
        "key": "cart:{userId}",
        "pattern": "Hash",
        "ttl": "24h",
        "purpose": "Shopping cart storage"
      },
      {
        "key": "session:{token}",
        "pattern": "String",
        "ttl": "30m",
        "purpose": "JWT session cache"
      },
      {
        "key": "product:cache:{id}",
        "pattern": "String (JSON)",
        "ttl": "1h",
        "purpose": "Product detail cache"
      },
      {
        "key": "rate:limit:{ip}",
        "pattern": "Counter",
        "ttl": "1m",
        "purpose": "API rate limiting"
      }
    ],
    "securityArchitecture": [
      {
        "layer": "Edge",
        "implementation": "API Gateway with JWT validation, rate limiting, CORS"
      },
      {
        "layer": "Authentication",
        "implementation": "Spring Security + JWT (RS256), refresh tokens in HttpOnly cookies"
      },
      {
        "layer": "Authorization",
        "implementation": "Role-based access (USER, ADMIN, SELLER) with method-level @PreAuthorize"
      },
      {
        "layer": "Transport",
        "implementation": "TLS 1.3 everywhere, mTLS between services in K8s"
      },
      {
        "layer": "Data",
        "implementation": "Encrypted at rest (AES-256), PII tokenization, audit logging"
      }
    ],
    "deploymentArchitecture": [
      {
        "component": "EKS Cluster",
        "description": "3-node minimum, auto-scaling 3-20 pods per service"
      },
      {
        "component": "RDS PostgreSQL",
        "description": "Multi-AZ, read replicas for catalog/order DBs"
      },
      {
        "component": "ElastiCache Redis",
        "description": "Cluster mode, 3 shards for cart/session cache"
      },
      {
        "component": "MSK Kafka",
        "description": "3-broker cluster, 7-day retention"
      },
      {
        "component": "CloudFront + ALB",
        "description": "CDN for static assets, ALB for API traffic"
      }
    ],
