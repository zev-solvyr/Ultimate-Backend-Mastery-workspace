        "name": "Transfer Saga (2PC)",
        "steps": [
          "Client initiates transfer",
          "Transfer Service locks source account",
          "Fraud Service scores transaction",
          "If approved: debit source, credit destination",
          "Publish transfer.completed event",
          "Notification Service alerts both parties",
          "On failure: rollback with compensating entries"
        ]
      },
      {
        "name": "Fraud Detection Pipeline",
        "steps": [
          "Transaction event consumed from Kafka",
          "Fraud Service checks velocity rules in Redis",
          "ML model scores transaction risk",
          "High-risk → block + alert compliance team",
          "Low-risk → approve and continue saga"
        ]
      }
